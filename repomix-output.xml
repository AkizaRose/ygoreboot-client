<file path="src/components/DuelField/FieldZone.tsx">
import { useEffect, useRef, useState } from 'react';
import { AnimatePresence, motion } from 'framer-motion';
import type { CardData } from '../../types/Card';
import './FieldZone.css';

// Matches the zone box's own size (see .FieldZone in FieldZone.css).
const ZONE_WIDTH = 72;
const ZONE_HEIGHT = 105;

// Same delay-before-hide reasoning as Hand's context menu — without it,
// the menu (which only renders while hovered) would unmount the instant
// the cursor crosses the small visual gap between the card and the menu
// above it, before it can ever reach the menu.
const MENU_HIDE_DELAY_MS = 150;

export interface FieldZoneAction {
  key: string;
  label: string;
}

interface FieldZoneProps {
  label: string;
  // The occupying card, if any — no longer used to RENDER anything here
  // (see CardLayer, in src/duel/), only for this zone's own logic: is
  // there something here to hover/click/show a menu for, and what ATK/
  // DEF should the stats overlay below show. The actual card art for
  // whatever's in this zone is a separate, independently-positioned
  // element in CardLayer, which happens to sit visually on top of this
  // zone's own footprint whenever nothing's mid-move.
  card?: CardData;
  // Whether `card` is currently showing face-down (Set) — still matters
  // here even without rendering anything: hover still reports the real
  // card via onCardHover regardless, so Card Display can reveal it.
  faceDown?: boolean;
  // When provided (and no `card`), this zone represents a face-down pile
  // (Main Deck / Extra Deck) rather than a single card slot — used for
  // the pile-count badge and to enable the deck menu/click-to-draw,
  // same as `card` does for single-card zones.
  image?: string;
  count?: number;
  onClick?: () => void;
  // Purely visual — a highlighted border indicating this zone is
  // currently chosen as part of some in-progress multi-select
  // interaction (e.g. Fusion Summon material selection). Independent of
  // onClick itself; a zone can be clickable without being selected, or
  // (in principle) selected without being clickable.
  selected?: boolean;
  // Only relevant when `card` is present — reports the real card
  // regardless of faceDown, so Card Display can reveal it even though
  // the field itself shows a card back. Never fires for pile content
  // (image), since a face-down pile has no single card to reveal.
  onCardHover?: (card: CardData) => void;
  onCardHoverEnd?: () => void;
  // A plain boolean, separate from onCardHover above — that callback
  // reports the CARD (for Card Display, shared across every hoverable
  // surface in the app), not which specific zone/instance this is. This
  // zone doesn't know its own instanceId at all (see the top-level
  // `card` comment above — actual card identity/rendering moved to
  // CardLayer some time ago), so it can only report "hovering" or not;
  // the caller (DuelField.tsx) is what resolves that against whichever
  // instanceId it already knows for this specific slot. Used for the
  // Equip Spell hover-overlay specifically (see CardLayer's own
  // equipOverlayInstanceId) — nothing else needs zone-level hover
  // identity yet.
  onHoverChange?: (hovering: boolean) => void;
  // The 5 field-card actions, or "View" for Main/Extra Deck — see
  // DuelField.tsx for which one gets passed where.
  menuActions?: FieldZoneAction[];
  onMenuAction?: (actionKey: string) => void;
  // A visual guide for Defense Position: a copy of this zone's own box,
  // rotated -90° around its center, showing how much extra width a
  // rotated (Defense Position) card would occupy. Purely decorative for
  // now — only ever passed for Monster Zones.
  showRotatedOverlay?: boolean;
  // Only meaningful for face-up Monster Zone cards — drives the ATK/DEF
  // stats overlay below (which value is dimmed), independently of
  // however CardLayer happens to be rendering/rotating the card itself
  // right now.
  battlePosition?: 'attack' | 'defense';
  // Manually adjusted stats (see StatAdjustDialog) — null/undefined
  // means "use card.atk/card.def as-is." Only ever meaningful alongside
  // battlePosition above, for the same face-up Monster Zone cards.
  atkOverride?: number | null;
  defOverride?: number | null;
  // Opens StatAdjustDialog — only ever wired up for the player's OWN
  // Monster Zones (see DuelField.tsx), never the opponent's. Presence
  // alone is what makes the stats overlay itself clickable at all (see
  // its pointer-events handling below); omitted entirely rather than
  // passed-but-disabled for the opponent's side.
  onStatsClick?: () => void;
  // Only Monster Zones render ATK/DEF. Grave, Banished, Field, and
  // Spell/Trap Zones can also receive a Monster card for their top-card
  // display, but must never show the Monster Zone stats overlay.
  showStats?: boolean;
  // True for every zone on the opponent's (flipped) side. Only used here
  // to flip the stats overlay's own vertical position (see
  // .FieldZone-statsOverlay--top in FieldZone.css) — the card's own
  // rotation is CardLayer's concern entirely now, not this component's.
  rotated180?: boolean;
  // How far the pile's actual top card has drifted from this zone's own
  // base position, in pixels — see DuelField.tsx's own topCardOffset,
  // which computes this using the exact same per-layer step/cap math
  // that positions the real top card (in cardPositions.ts). Nudges the
  // pile count label to track the top card as a pile grows, rather than
  // staying fixed to the zone itself and drifting visibly off-center
  // from a large pile's actual top card.
  pileCountOffsetX?: number;
  pileCountOffsetY?: number;
}

function FieldZone({
  label,
  card,
  faceDown = false,
  image,
  count,
  onClick,
  selected = false,
  onCardHover,
  onCardHoverEnd,
  onHoverChange,
  menuActions,
  onMenuAction,
  showRotatedOverlay = false,
  battlePosition = 'attack',
  atkOverride = null,
  defOverride = null,
  onStatsClick,
  showStats = false,
  rotated180 = false,
  pileCountOffsetX = 0,
  pileCountOffsetY = 0,
}: FieldZoneProps) {
  const [showMenu, setShowMenu] = useState(false);
  const hideTimeoutRef = useRef<number | undefined>(undefined);

  const hasContent = !!card || !!image;
  const menuEnabled = hasContent && !!menuActions && menuActions.length > 0;

  const cancelHide = () => {
    if (hideTimeoutRef.current !== undefined) {
      window.clearTimeout(hideTimeoutRef.current);
      hideTimeoutRef.current = undefined;
    }
  };

  const scheduleHide = () => {
    cancelHide();
    hideTimeoutRef.current = window.setTimeout(() => {
      setShowMenu(false);
    }, MENU_HIDE_DELAY_MS);
  };

  useEffect(() => () => cancelHide(), []);

  const handleMouseEnter = () => {
    cancelHide();
    if (menuEnabled) setShowMenu(true);
    if (card) onCardHover?.(card);
    if (card) onHoverChange?.(true);
  };

  const handleMouseLeave = () => {
    scheduleHide();
    if (card) onCardHoverEnd?.();
    if (card) onHoverChange?.(false);
  };

  const handleAction = (event: React.MouseEvent, actionKey: string) => {
    // Stops this click from also bubbling up to the zone's own onClick —
    // matters for Main Deck, which has both "click to draw" AND a menu
    // with a "View" action; without this, clicking View would also draw
    // a card.
    event.stopPropagation();
    cancelHide();
    setShowMenu(false);
    onMenuAction?.(actionKey);
  };

  return (
    <div
      className={[
        'FieldZone',
        onClick && 'FieldZone--clickable',
        selected && 'FieldZone--selected',
      ]
        .filter(Boolean)
        .join(' ')}
      onClick={onClick}
      onMouseEnter={handleMouseEnter}
      onMouseLeave={handleMouseLeave}
    >
      <AnimatePresence>
        {menuEnabled && showMenu && (
          <motion.div
            key="context-menu"
            className="FieldZone-contextMenu"
            // x replaces what used to be a plain CSS
            // transform:translateX(-50%) — needed so it composes
            // correctly with the animated y offset below (both are
            // framer-motion-managed values that combine into one final
            // transform; mixing a raw CSS transform string with an
            // animated one on the same element doesn't compose the way
            // a person might expect).
            style={{ x: '-50%' }}
            initial={{ y: 8, opacity: 0 }}
            animate={{ y: 0, opacity: 1 }}
            exit={{ y: 8, opacity: 0 }}
            transition={{ duration: 0.15, ease: 'easeOut' }}
          >
            {menuActions!.map((action) => (
              <button
                key={action.key}
                type="button"
                className="FieldZone-contextMenuButton"
                onClick={(e) => handleAction(e, action.key)}
              >
                {action.label}
              </button>
            ))}
          </motion.div>
        )}
      </AnimatePresence>
      {showRotatedOverlay && (
        <div
          className="FieldZone-rotatedOverlay"
          style={{ width: ZONE_WIDTH, height: ZONE_HEIGHT }}
        />
      )}
      {/* No card/pile art rendered here anymore — CardLayer (src/duel/)
          renders every card as its own independently-positioned element,
          which sits visually on top of this zone's footprint whenever
          nothing's mid-move. This div's only remaining visual jobs: the
          zone's own border/background (see .FieldZone in FieldZone.css),
          the rotated overlay above, the stats overlay and pile count
          below, and the plain text label when this zone is empty. */}
      {!hasContent && <span className="FieldZone-label">{label}</span>}
      {showStats &&
        card &&
        !faceDown &&
        card.cardClass === 'Monster' &&
        (card.atk || card.def) &&
        (() => {
          // card.atk/card.def are strings in this codebase's own data
          // (e.g. "2500", occasionally something non-numeric for a
          // variable-stat card) — kept as-is here for DISPLAY, so a
          // card with a genuinely non-numeric base stat still shows
          // whatever that string actually is rather than "NaN". A
          // separate, parsed numeric value is used only for the
          // increased/decreased COMPARISON below, since atkOverride
          // (once set, from StatAdjustDialog) is always a real number.
          const baseAtk = card.atk;
          const baseDef = card.def;
          const effectiveAtk = atkOverride ?? baseAtk;
          const effectiveDef = defOverride ?? baseDef;
          const baseAtkNum = baseAtk !== undefined ? Number(baseAtk) : NaN;
          const baseDefNum = baseDef !== undefined ? Number(baseDef) : NaN;
          // Only meaningful when there's actually an override to compare
          // AND the base parses to a real number — a card with a
          // non-numeric base stat falls through to no adjustment
          // styling at all, rather than a nonsensical comparison.
          const atkAdjustClass =
            atkOverride != null && !Number.isNaN(baseAtkNum) && atkOverride !== baseAtkNum
              ? atkOverride > baseAtkNum
                ? 'FieldZone-statsOverlay--increased'
                : 'FieldZone-statsOverlay--decreased'
              : undefined;
          const defAdjustClass =
            defOverride != null && !Number.isNaN(baseDefNum) && defOverride !== baseDefNum
              ? defOverride > baseDefNum
                ? 'FieldZone-statsOverlay--increased'
                : 'FieldZone-statsOverlay--decreased'
              : undefined;
          return (
            <div
              className={[
                'FieldZone-statsOverlay',
                rotated180 && 'FieldZone-statsOverlay--top',
                onStatsClick && 'FieldZone-statsOverlay--clickable',
              ]
                .filter(Boolean)
                .join(' ')}
              onClick={
                onStatsClick
                  ? (event) => {
                      // Stops this from also reaching the zone's own
                      // onClick (e.g. Fusion/Evolution material
                      // selection) — the overlay is a distinct,
                      // dedicated click target, not a proxy for the
                      // zone's own click behavior.
                      event.stopPropagation();
                      onStatsClick();
                    }
                  : undefined
              }
            >
              <span
                className={[
                  battlePosition === 'defense' && 'FieldZone-statsOverlay--dimmed',
                  atkAdjustClass,
                ]
                  .filter(Boolean)
                  .join(' ')}
              >
                {effectiveAtk ?? '?'}
              </span>
              /
              <span
                className={[
                  battlePosition !== 'defense' && 'FieldZone-statsOverlay--dimmed',
                  defAdjustClass,
                ]
                  .filter(Boolean)
                  .join(' ')}
              >
                {effectiveDef ?? '?'}
              </span>
            </div>
          );
        })()}
      {count != null && (
        <span
          className="FieldZone-pileCount"
          style={
            pileCountOffsetX || pileCountOffsetY
              ? { transform: `translate(${pileCountOffsetX}px, ${pileCountOffsetY}px)` }
              : undefined
          }
        >
          {count}
        </span>
      )}
    </div>
  );
}

export default FieldZone;
</file>

<file path="src/pages/MultiplayerDuelFieldPage.css">
.MultiplayerDuelFieldPage {
  position: relative;
  width: 1400px;
  height: 660px;
  box-sizing: border-box;
  background: var(--bg);
  display: flex;
  flex-direction: row;
  gap: 12px;
  padding: 6px;
  align-items: flex-start;
  overflow: hidden;
}

.MultiplayerDuelFieldPage-sidePanel {
  flex-shrink: 0;
  /* Normally just the Card Viewer alone — during Side Decking, this also
     holds the Swap Cards/Reset Deck/Done Siding block (see
     SideDecking-sidePanelActions), stacked directly beneath it. A plain
     column with a gap is enough for that; it's a no-op for the normal
     duel field's own single child. */
  display: flex;
  flex-direction: column;
  gap: 4px;
}

/* Same idea as MultiplayerDuelFieldPage-opponentHud/-playerHud's own
   inline left/right override (see their own comments) — this is
   scoped to exclude the Side Decking screen (.MultiplayerDuelFieldPage
   --siding, rendered from a separate return with no board at all —
   see that return's own comment on why the HUDs stay position: absolute
   against the page there instead), which keeps this panel in normal
   flow, unaffected, at the page's own left edge. On the normal duel
   field, this takes it out of that same row-flex flow (previously
   sitting flush against the page's left edge/padding, unrelated to
   where .MultiplayerDuelFieldPage-content's own centered board actually
   ended up — the same mismatch the HUDs already had, on the other
   side) and lets the inline right: calc(...) style (set alongside this
   class in MultiplayerDuelFieldPage.tsx, using the same BOARD_WIDTH
   constant .content's own centering does) position it a fixed 16px to
   the LEFT of the board instead. top: 6px reproduces the same vertical
   position the row's own align-items: flex-start plus the page's own
   6px padding gave it before, the same reasoning as
   MultiplayerDuelFieldPage-content's own top: 6px. */
.MultiplayerDuelFieldPage:not(.MultiplayerDuelFieldPage--siding) .MultiplayerDuelFieldPage-sidePanel {
  position: absolute;
  top: 6px;
}

/* Taken out of the row's flex flow and centered directly against
   .MultiplayerDuelFieldPage itself (the fixed, exactly-1400px box the
   page centers on screen) via left: 50% + a negative margin-left equal
   to half its own width, rather than centered within its own remaining
   share of the row after .sidePanel. Sharing row space with sidePanel
   meant the duel field's true center point shifted right by roughly
   half of sidePanel's own width + the row's gap — off-center compared
   with the page as a whole, which is what this fixes.
   top: 6px reproduces the same vertical position this had before (the
   row's own align-items: flex-start plus padding: 6px), just expressed
   directly instead of inherited from the flex layout.
   Deliberately margin-left, NOT transform: translateX(-50%): a
   transform on this element would make it the containing block for
   every position: fixed descendant underneath it (per the CSS spec) —
   including .MultiplayerDuelFieldPage-opponentHandLayer, whose whole
   point is to stay fixed to the real viewport so the page's own
   clipping can't cut off the opponent's hand. margin-left centers
   equally well without that side effect. The actual pixel value is set
   inline in MultiplayerDuelFieldPage.tsx (half of BOARD_WIDTH), so it
   can't silently drift out of sync with the board's real width. */
.MultiplayerDuelFieldPage-content {
  position: absolute;
  top: 6px;
  left: 50%;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

/* Exit / Admit Defeat / Offer Draw / the best-of-three duel status — all
   grouped together in normal document flow, stacked directly beneath the
   Card Viewer inside .MultiplayerDuelFieldPage-sidePanel (see that
   element's own render in MultiplayerDuelFieldPage.tsx). A plain column
   with a small gap is all that's needed; each row below (topActions,
   matchActionsRow, matchStatus) used to be independently
   position: absolute against the page itself — replaced with this single
   flow-based wrapper so they sit truly inside the same column as the
   Card Viewer, not just visually aligned with it. */
.MultiplayerDuelFieldPage-sidePanelActions {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.MultiplayerDuelFieldPage-topActions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

/* Matches the look of the buttons it now sits directly above (Admit
   Defeat/Offer Draw) rather than its own old bare, unstyled look — the
   old .MultiplayerDuelFieldPage-topActions button rule gave Exit no
   border or background of its own, which read oddly once grouped with
   its new siblings. */
.MultiplayerDuelFieldPage-exitButton {
  font-family: "Yu-Gi-Oh!ITCStoneSerifSmallCaps";
  font-size: 12px;
  padding: 2px 10px;
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  background: #16171dee;
  color: var(--text);
  cursor: pointer;
  width: 100.5px;
}

.MultiplayerDuelFieldPage-exitButton:hover {
  background: rgba(255, 255, 255, 0.1);
}

/* Sits directly beside Exit in the same .topActions row — same look,
   just without the fixed 100.5px width (Exit's own width was sized to
   match its old standalone layout; "Duel Log" is a different length and
   this row already wraps via flex-wrap if the two ever don't fit side
   by side, so there's no need to force a matching width here). */
.MultiplayerDuelFieldPage-duelLogButton {
  font-family: "Yu-Gi-Oh!ITCStoneSerifSmallCaps";
  font-size: 12px;
  padding: 2px 10px;
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  background: #16171dee;
  color: var(--text);
  cursor: pointer;
  width: 100.5px
}

.MultiplayerDuelFieldPage-duelLogButton:hover {
  background: rgba(255, 255, 255, 0.1);
}

/* --- Duel Log overlay ---
   position: fixed + inset: 0 deliberately takes this OUT of document
   flow entirely, per the original request that it "shouldn't interfere
   with the positioning of any other elements on the page" — every other
   element keeps its exact layout regardless of whether this is open. */
.MultiplayerDuelFieldPage-duelLogOverlay {
  position: fixed;
  width: 256px;
  max-width: 90vw;
  height: 460px;
  max-height: 80vh;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: left;
  justify-content: left;
  padding: 4px;
}

.MultiplayerDuelFieldPage-duelLogPanel {
  width: 256px;
  max-width: 90vw;
  height: 460px;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  background: #16171dee;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 6px;
  overflow: hidden;
}

.MultiplayerDuelFieldPage-duelLogHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4px 8px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}

.MultiplayerDuelFieldPage-duelLogTitle {
  font-family: "Yu-Gi-Oh!ITCStoneSerifSmallCaps";
  font-size: 16px;
  color: var(--text);
}

.MultiplayerDuelFieldPage-duelLogCloseButton {
  font-family: "Yu-Gi-Oh!ITCStoneSerifSmallCaps";
  font-size: 12px;
  padding: 2px 10px;
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  background: #16171dee;
  color: var(--text);
  cursor: pointer;
}

.MultiplayerDuelFieldPage-duelLogCloseButton:hover {
  background: rgba(255, 255, 255, 0.1);
}

.MultiplayerDuelFieldPage-duelLogEntries {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 2px 2px;
  text-align: left;
}

.MultiplayerDuelFieldPage-duelLogEmpty {
  font-family: 'Yu-Gi-Oh! Matrix Book';
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
  text-align: left;
  margin-top: 12px;
}

.MultiplayerDuelFieldPage-duelLogEntry {
  font-family: 'Yu-Gi-Oh! Matrix Book';
  font-size: 12px;
  line-height: 14px;
  overflow-wrap: anywhere;
}

.MultiplayerDuelFieldPage-duelLogTimestamp {
  color: rgba(255, 255, 255, 0.5);
}

/* Same red/blue/white convention as MultiplayerDuelFieldPage-chatBubble's
   own --mine/--opponent/--system modifiers, just as plain text color
   here (full opacity, unlike the chat bubble's translucent fill) rather
   than a background, per the request that these render as colored text
   entries in a single scrolling list. */
.MultiplayerDuelFieldPage-duelLogEntry--mine {
  color: #ff6b6b;
}

.MultiplayerDuelFieldPage-duelLogEntry--opponent {
  color: #6bb3ff;
}

.MultiplayerDuelFieldPage-duelLogEntry--system {
  color: var(--text);
}

.MultiplayerDuelFieldPage-matchStatus {
  font-family: 'Yu-Gi-Oh!ITCStoneSerifSmallCaps';
  font-size: 12px;
  color: var(--text);
  line-height: 16px;
  text-align: left;
}

.MultiplayerDuelFieldPage-fieldArea {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 0;
}

/* Same column as .MultiplayerDuelFieldPage-playerHud (right: 12px), just
   anchored to the top of the page instead of the bottom — and the same
   column/right-alignment layout direction, so the two visually line up
   as a matching pair rather than sitting in different corners. */
.MultiplayerDuelFieldPage-opponentHud {
  position: absolute;
  top: 8px;
  right: 4px;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
}

.MultiplayerDuelFieldPage-hudUsername {
  font-family: 'Nova Square';
  font-size: 14px;
  color: var(--text);
  line-height: 12px;
}

/* Wraps just the username (not the LP counter below it), per request for
   an opaque black background behind only the username row. align-self:
   stretch overrides .hudInfo's own align-items: flex-end (below) so this
   row spans the column's full width — without it, a plain block div here
   would still only size to its own content the way align-items: flex-end
   would otherwise shrink-wrap it, and the black background would only
   cover the username text itself rather than reading as a full row.
   The negative margin cancels out .hudInfo's own padding (2px 6px) on the
   top/left/right sides specifically, so this row's background reaches
   .hudInfo's actual top/left/right edges rather than leaving that padding
   as a visible gap — its own padding then reinstates the same inset for
   the username text. The bottom side is left alone: .hudInfo's own
   padding/gap below this row (between it and the LP counter) isn't part
   of this request.
   The colored top border (below) lives on THIS element rather than on
   .hudInfo, even though the negative top margin still lines this row's
   top edge up with .hudInfo's own — putting the border and this row's
   opaque background on two different elements let the browser round
   each one's edges independently at fractional scale factors (e.g. the
   window resized to a non-integer zoom level), which could round the
   background's edge outward by a device pixel and paint over the
   border-top living on the parent, making it disappear. With both on
   this one element, they're rounded together and can't drift apart. */
.MultiplayerDuelFieldPage-hudUsernameRow {
  align-self: stretch;
  margin: -2px -6px 0 -6px;
  padding: 2px 6px;
  background: #000000;
  /* display: flex is what closes the dead space above the username text
     — without it, this is a plain block box around an inline (span)
     child, and a block box's height in that case comes from a LINE BOX,
     which also has to fit an invisible "strut" the size of THIS block's
     own inherited font/line-height (inherited from way up the tree,
     since neither this class nor .hudInfo sets one) — not the
     username span's own, much shorter, explicit line-height: 12px. That
     inherited strut being taller than the username text itself is what
     was padding the row out above the text (the same root cause already
     fixed on .LifePointCounter's own wrapper, for the same reason).
     align-items: center then centers the text within whatever's left
     (mainly the 2px 6px padding above), rather than the flex default
     (stretch) leaving the span's own box exactly as tall as its text
     but positioned flush at the container's own top edge either way. */
  display: flex;
  align-items: center;
}

.MultiplayerDuelFieldPage-hudRow--player .MultiplayerDuelFieldPage-hudUsernameRow {
  border-top: 1px solid #d32f2f;
}

.MultiplayerDuelFieldPage-hudRow--opponent .MultiplayerDuelFieldPage-hudUsernameRow {
  border-top: 1px solid #1976d2;
}

/* The avatar box, to the right, spanning the full height of the
   username/LP counter stacked in .hudInfo to its left — used identically
   by both opponentHud and playerHud, both now sharing the SAME order for
   .hudInfo's own two children (username above LP counter), per request.
   align-items: center rather than stretch — the avatar box has its own
   fixed 64px height (see PlayerAvatarBox.css), so this centers it
   against whatever height hudInfo's own two stacked rows actually come
   out to, rather than stretching the avatar itself to match. */
.MultiplayerDuelFieldPage-hudRow {
  display: flex;
  flex-direction: row;
  /* No gap, per request — the hudInfo column and the avatar box should
     look attached to one another, not visually separated. */
  gap: 0;
  /* Matches MultiplayerDuelFieldPage-chatInputRow/-chatHistory's own
     216px width (see those classes' own comments) — requested so this
     row (the avatar box plus the username/LP counter stack in
     .hudInfo) lines up with the chat box above/below it. */
  width: 216px;
  box-sizing: border-box;
  /* PlayerAvatarBox is a fixed 84px box, not a flexing one (despite that
     class's own comment describing a flex: 1 approach — that was never
     actually implemented there, just written up as the intent), and
     .hudInfo only ever sizes to its own content (the username/LP text),
     not to whatever's left over. Without justify-content here, the
     default flex-start packs both against the LEFT edge of this row
     instead, leaving a gap on the right — of variable size depending on
     how wide the username happens to be — between the avatar and this
     row's own 216px edge, rather than the avatar always sitting flush
     against it. flex-end fixes that by packing both against the RIGHT
     edge instead, per request, regardless of the username's length. */
  justify-content: flex-end;
}

/* Both sides now share the same top-aligned cross-axis alignment, per
   request — the hudInfo column always starts at the same height as the
   avatar box, rather than (for the player's own side, previously)
   bottom-aligning the two instead. Kept as two separate modifiers rather
   than folded into the shared MultiplayerDuelFieldPage-hudRow rule above,
   in case the two sides ever need to diverge again. */
.MultiplayerDuelFieldPage-hudRow--opponent {
  align-items: flex-start;
}

.MultiplayerDuelFieldPage-hudRow--player {
  align-items: flex-start;
}

/* The background here is the same color/opacity as
   MultiplayerDuelFieldPage-duelLogPanel's own (#16171dee), per request —
   covering the whole username+LP-counter column, not just the LP
   counter's own former background (removed below, from
   LifePointCounter-display, along with its border). A little padding
   keeps that background from crowding right up against the text/counter
   it now sits behind.
   flex: 1 (rather than this sizing to just its own content, the
   username/LP text) makes this always fill whatever width
   MultiplayerDuelFieldPage-hudRow's own justify-content: flex-end (see
   that class's own comment) leaves it once the fixed-84px avatar box
   next to it is accounted for — so this column's own background always
   spans the row's full remaining width, per request, rather than
   shrink-wrapping tightly around the username/LP text. min-width: 0 is
   needed alongside it, the same reasoning as PlayerAvatarBox's own
   former flex-item sizing (see that class's own comment) — flex items
   default to a min-width equal to their content's own natural size
   otherwise, which would stop this shrinking on a very long username
   rather than letting it wrap/truncate within the space actually
   available. text-align: right (alongside align-items: flex-end, which
   only positions each child's own box, not the text/inline content
   inside it) is what actually right-aligns the username/LP text itself
   now that this column is wider than that text, per request. */
.MultiplayerDuelFieldPage-hudInfo {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex: 1;
  min-width: 0;
  text-align: right;
  gap: 4px;
  padding: 2px 6px;
  background: #16171dee;
}

/* Overrides LifePointCounter-display's own :hover and cursor — those
   exist there to signal "click to edit," which doesn't apply here (a
   player can never edit their opponent's life points), so this stays
   visually inert on hover rather than looking clickable. The combined
   selector (both classes, not just this one) is what guarantees this
   wins over the single-class :hover rule regardless of which
   stylesheet happens to load second. */
.LifePointCounter-display.MultiplayerDuelFieldPage-opponentLpDisplay {
  cursor: default;
}

/* Cancels LifePointCounter-display's own :hover background (see that
   class's own comment) back to none, now that the base class no longer
   carries a background of its own to hover away from — the .hudInfo
   column background behind it (see that class's own comment above)
   shows through undisturbed either way. */
.LifePointCounter-display.MultiplayerDuelFieldPage-opponentLpDisplay:hover {
  background: transparent;
}

.MultiplayerDuelFieldPage-playerHud {
  position: absolute;
  bottom: 8px;
  right: 4px;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
}

/* --- Chat ---
   Both the history box and the input box below share this same fixed
   width, so the two line up into one visually consistent column rather
   than the history box's width just being whatever its longest message
   happens to need. */
.MultiplayerDuelFieldPage-chatHistory {
  /* border-box, not the 210px content-box this used to be — that left
     this 6px WIDER than .hudRow/.chatInputRow's own 216px (border-box,
     padding already included), since its 4px 6px padding was being
     added on top of the 210px instead of eating into it, despite this
     class's own width being intended to match those two. That mismatch
     is what let the hud drift out of flush alignment with the chat box
     below/above it, since .opponentHud/.playerHud's own align-items:
     flex-end right-aligns each stacked child to whichever one of them
     actually renders widest — which was this one. */
  width: 216px;
  height: 420px;
  box-sizing: border-box;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  /* Messages still render top-to-bottom in the normal (oldest-first)
     order — this only changes where they sit when there AREN'T enough of
     them to fill the box yet: pinned to the bottom edge, messaging-app
     style, rather than stacking from the top with empty space left
     underneath. Once there are enough messages to fill the box, this has
     no visible effect and overflow-y: auto/the existing auto-scroll
     effect (see chatHistoryRef) behave exactly as before. */
  justify-content: flex-end;
  gap: 6px;
  padding: 4px 6px;
  background: #00000000;
}

.MultiplayerDuelFieldPage-chatMessage {
  display: flex;
  /* Top-aligned, not centered — the avatar should stay pinned to the
     first line of its own message even once that message wraps onto
     several lines, rather than drifting to the vertical center of the
     whole bubble. */
  align-items: flex-start;
  gap: 4px;
  min-width: 0px;
}

/* Own messages: avatar top-left, message box to its right (the default
   row direction already puts them in that order). Opponent's messages:
   avatar top-right, message box to its left — row-reverse is simplest
   way to flip just the ORDER without needing a second, mirrored set of
   margin/alignment rules. */
.MultiplayerDuelFieldPage-chatMessage--opponent {
  flex-direction: row-reverse;
}

.MultiplayerDuelFieldPage-chatAvatar {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  display: block;
}

.MultiplayerDuelFieldPage-chatBubble {
  min-width: 0px;
  padding: 3px 6px;
  border-radius: 4px;
  font-family: 'Yu-Gi-Oh! Matrix Book';
  font-size: 12px;
  color: white;
  overflow-wrap: anywhere;
  line-height: 16px;
}

/* Red/blue at 50% opacity, per request — the same red/blue used
   elsewhere in this app to distinguish "mine" from "opponent's" (see
   PlayerAvatarBox.css's own --myTurn/--opponentTurn border colors),
   just as a translucent fill here instead of a border. */
.MultiplayerDuelFieldPage-chatBubble--mine {
  background: rgba(211, 47, 47, 0.25);
  text-align: left;
}

.MultiplayerDuelFieldPage-chatBubble--opponent {
  background: rgba(25, 118, 210, 0.25);
  text-align: left;
}

/* Automated system messages (e.g. "[Player] has admitted defeat") — see
   ChatMessage's own comment on the 'system' role and renderChatMessage's
   own use of this class. White at 30% opacity, per request, rather than
   either player's own red/blue, so it reads as neither player's own
   message. */
.MultiplayerDuelFieldPage-chatBubble--system {
  background: rgba(255, 255, 255, 0.3);
  text-align: left;
}

/* Holds the chat input plus the two expression buttons beside it — the
   row's total width matches what the input's own width used to be
   (216px) before the buttons were added, so the chat column's overall
   footprint hasn't changed; the input itself now flexes to fill
   whatever's left after the two fixed-size buttons instead of owning a
   fixed width of its own. */
.MultiplayerDuelFieldPage-chatInputRow {
  width: 216px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 4px;
}

.MultiplayerDuelFieldPage-chatInput {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  font-family: 'Yu-Gi-Oh! Matrix Book';
  font-size: 12px;
  padding: 6px 8px;
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  background: #16171dee;
  color: white;
}

.MultiplayerDuelFieldPage-chatInput::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.MultiplayerDuelFieldPage-chatInput:focus {
  outline: none;
  border-color: rgba(255, 255, 255, 0.6);
}

/* The two emoji-style expression buttons next to the chat input — plain
   image buttons, no button chrome of their own (background/border), so
   they read as clickable icons rather than form controls. */
.MultiplayerDuelFieldPage-expressionButton {
  flex-shrink: 0;
  width: 22px;
  height: 22px;
  padding: 0;
  border: none;
  background: transparent;
  cursor: pointer;
}

.MultiplayerDuelFieldPage-expressionButton img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.MultiplayerDuelFieldPage-expressionButton:hover {
  opacity: 0.75;
}

/* The transient thumbs-up/thinking overlay itself — rendered as a child
   of .PlayerAvatarBox (see that class's own position: relative, which
   this is positioned against), for both the player's own avatar (via
   PlayerAvatarBox's own overlay prop) and the opponent's (inserted
   directly into their own avatar box markup, which uses the same
   .PlayerAvatarBox class but isn't built through that component).
   pointer-events: none so it never intercepts a click aimed at the
   avatar box underneath it.

   The whole grow-in/hold/shrink-out lifecycle is just one CSS animation,
   timed to the same ~3 seconds MultiplayerDuelFieldPage's own
   handleSendExpression clears the underlying Firestore field after —
   see that function's own comment. Growing FROM/shrinking TO scale(0)
   (not just an opacity fade) is the actual "grow"/"shrink" transition
   requested — opacity is layered on top purely so it doesn't render as
   a visible zero-size dot for an instant at the very start/end. */
.MultiplayerDuelFieldPage-expressionOverlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  animation: MultiplayerDuelFieldPage-expressionPulse 3s ease-in-out forwards;
}

@keyframes MultiplayerDuelFieldPage-expressionPulse {
  0% {
    transform: scale(0);
    opacity: 0;
  }
  12% {
    transform: scale(1);
    opacity: 1;
  }
  85% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(0);
    opacity: 0;
  }
}

.MultiplayerDuelFieldPage-expressionOverlayImage {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

/* Thumbs-up specifically, once it's grown to full size, keeps
   oscillating between 80% and 100% of that size for as long as it stays
   up — layered on top of (multiplied with) the outer envelope's own
   grow/shrink scale above, since this animates the INNER img's own
   transform, a separate element from the one the envelope animates.
   animation-delay matches the envelope's own 12% grow point (12% of the
   3s envelope = 0.36s) so the pulse only kicks in once thumbs-up has
   actually finished growing in, not while it's still on the way up. */
.MultiplayerDuelFieldPage-expressionOverlayImage--thumbsUp {
  animation: MultiplayerDuelFieldPage-thumbsUpPulse 0.6s ease-in-out 0.36s infinite;
}

@keyframes MultiplayerDuelFieldPage-thumbsUpPulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.8);
  }
}

/* The "Viewing [location]" text overlay's own background/layout — same
   child-of-.PlayerAvatarBox positioning as
   MultiplayerDuelFieldPage-expressionOverlay above (relying on that
   class's own position: relative), and the same pointer-events: none so
   it never intercepts a click meant for the avatar box underneath
   (inherited by its children too, since pointer-events is an inherited
   property). Deliberately a PLAIN element, not a motion component — the
   dark scrim it draws should appear/disappear instantly alongside the
   text rather than growing/shrinking with it; see
   renderViewingLocationOverlay's own comment for the three-layer
   breakdown (this class is the outermost of the three) and why the
   grow-in/shrink-out lives on the middle layer instead. */
.MultiplayerDuelFieldPage-viewingLocationOverlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 4px;
  box-sizing: border-box;
  pointer-events: none;
  background: rgba(0, 0, 0, 0.65);
}

/* The label text itself — RoGSanSrfStd-UB/white/1px black stroke, per
   request, the same font-family/color/-webkit-text-stroke convention
   Card.css's own .atkValue/.defValue already use (just 1px here rather
   than their 3px, since this is much smaller text sitting over a
   player's avatar, not a large card stat). The oscillating-scale pulse,
   once grown in, mirrors MultiplayerDuelFieldPage-thumbsUpPulse's own
   technique above — kept on this INNERMOST span, separate from the
   surrounding motion.span's own grow/shrink scale (see
   renderViewingLocationOverlay's own comment), for the same "one element
   can only ever have one `transform` in effect at a time" reason given on
   MultiplayerDuelFieldPage-expressionOverlayImage--thumbsUp above.
   display: inline-block is required for that pulse's own `transform` to
   have any effect at all — a plain inline box (a bare <span> is `inline`
   by default) isn't a transformable element per the CSS spec, and this
   one used to get away without setting it only because it was a DIRECT
   child of the flex container above (flex blockifies its own direct
   children, which is what made transform work here before). Now that
   it's nested one level deeper inside the grow/shrink motion.span
   (itself the flex item instead), it needs its own transform support
   declared explicitly rather than inheriting it for free from the
   flex layout. */
.MultiplayerDuelFieldPage-viewingLocationText {
  display: inline-block;
  font-family: 'RoGSanSrfStd-UB';
  font-size: 12px;
  line-height: 1.2;
  color: white;
  word-break: break-word;
  animation: MultiplayerDuelFieldPage-viewingLocationPulse 1.2s ease-in-out infinite;
}

@keyframes MultiplayerDuelFieldPage-viewingLocationPulse {
  0%,
  100% {
    transform: scale(1.08);
  }
  50% {
    transform: scale(1);
  }
}

/* The 60-second disconnect countdown — fills the whole avatar box (same
   position: absolute; inset: 0 technique as .expressionOverlay above,
   relying on the same PlayerAvatarBox's own position: relative), dimming
   the avatar underneath with a dark scrim so the number reads clearly
   against it regardless of the avatar image's own colors. */
.MultiplayerDuelFieldPage-disconnectCountdown {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.65);
  color: #ff5252;
  font-family: 'RoGSanSrfStd-UB';
  font-size: 26px;
  pointer-events: none;
}

/* The die roll's own shared, centered display (see this page's own
   activeDieRoll/dieRollSlot and DieRollDisplay in DieRoller.tsx) —
   positioned absolutely against .MultiplayerDuelFieldPage-boardStage via
   inline left/top/width/height (from getRevealZoneSlot()) rather than
   fixed values here, since that's the exact same box the Hand's own
   Reveal action and the Declare feature already share. z-index above
   CardLayer's own highest tier (400, see cardPositions.ts's own
   revealZoneEntry) so a simultaneous card reveal never covers it. */
.MultiplayerDuelFieldPage-dieRollZone {
  z-index: 410;
}

/* Row, not stacked — this is what puts the shuffle button to the LEFT
   of the LP counter specifically, at a fixed spot relative to it,
   rather than as just another item in the overall vertical stack
   .playerHud itself lays out. */
.MultiplayerDuelFieldPage-lpRow {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* A 2x2 grid of every "player action, not a card action" button, in DOM
   order: Die Roll/Coin Flip on top, Reveal Hand/Shuffle Hand underneath
   (see this page's own JSX) — a plain 2-column grid lays that out
   correctly on its own from DOM order alone, no explicit per-button
   placement needed. The whole group sits at the same fixed spot (to the
   LEFT of the LP counter) the hand buttons alone used to occupy.
   Die Roll/Coin Flip moved here from the duel field itself (see
   DuelField.tsx/.css's own comments on their old deckRow slot) — their
   buttons default to a much bigger, board-zone-sized footprint (see
   DieRoller.css/CoinFlipper.css), so the rule below shrinks them down to
   match Reveal/Shuffle Hand's own small icon-button size instead. */
.MultiplayerDuelFieldPage-handButtonRow {
  position: absolute;
  display: grid;
  grid-template-columns: repeat(2, auto);
  gap: 4px;
  bottom: 8px;
  right: 272px;
  z-index: 9999;
}

.MultiplayerDuelFieldPage-handButtonRow .DieRoller-button,
.MultiplayerDuelFieldPage-handButtonRow .CoinFlipper-button {
  width: 34px;
  height: 34px;
  padding: 6px;
}

/* Both buttons now render a single icon image (see MultiplayerDuelFieldPage-handButtonIcon
   below) rather than a text label — padding/border/background here just
   frame that icon in the same small dark square either button always
   had. */
.MultiplayerDuelFieldPage-shuffleHandButton {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px;
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  background: #16171dee;
  cursor: pointer;
}

.MultiplayerDuelFieldPage-shuffleHandButton:hover {
  background: rgba(255, 255, 255, 0.1);
}

/* Same base look as Shuffle Hand's own button — matched deliberately,
   rather than a shared class, so either can change independently later
   without the other silently drifting along with it (same reasoning as
   PhaseTracker/TurnCounter's own styling elsewhere in this app). */
.MultiplayerDuelFieldPage-revealHandButton {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px;
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  background: #16171dee;
  cursor: pointer;
}

.MultiplayerDuelFieldPage-revealHandButton:hover {
  background: rgba(255, 255, 255, 0.1);
}

/* Shared by both buttons' own icon image — a fixed square, small enough
   to sit comfortably in either button's own former text-label-sized
   footprint. */
.MultiplayerDuelFieldPage-handButtonIcon {
  width: 22px;
  height: 22px;
  object-fit: contain;
  display: block;
}

/* While active, a visibly different color from its own resting state —
   the only indicator (besides the label itself switching to "Hide
   Hand") that the opponent can currently see this hand. */
.MultiplayerDuelFieldPage-revealHandButton--active {
  background: #7a1f1fee;
  border-color: rgba(255, 255, 255, 0.4);
}

.MultiplayerDuelFieldPage-revealHandButton--active:hover {
  background: #8a2b2bee;
}

/* Now a normal-flow row inside .MultiplayerDuelFieldPage-sidePanelActions,
   directly beneath Exit — no longer needs position/z-index tricks to
   avoid being covered by .fieldArea, since it's no longer a sibling of
   it in the DOM. */
.MultiplayerDuelFieldPage-matchActionsRow {
  display: flex;
  gap: 6px;
}

/* Same base look as Shuffle Hand/Reveal Hand's own buttons, matched
   deliberately rather than a shared class (see those buttons' own
   comment on why) — plus a disabled state, since these two go
   permanently inert once the match is actually over. */
.MultiplayerDuelFieldPage-matchActionButton {
  font-family: "Yu-Gi-Oh!ITCStoneSerifSmallCaps";
  font-size: 12px;
  padding: 2px 10px;
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  background: #16171dee;
  color: var(--text);
  cursor: pointer;
  width: 100.5px;
}

.MultiplayerDuelFieldPage-matchActionButton:hover {
  background: rgba(255, 255, 255, 0.1);
}

.MultiplayerDuelFieldPage-matchActionButton:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  background: #16171dee;
}

.MultiplayerDuelFieldPage-status {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  background: var(--bg);
  font-family: 'Yu-Gi-Oh!ITCStoneSerifSmallCaps';
  color: var(--text);
  text-align: center;
}

.MultiplayerDuelFieldPage-status button {
  font-size: 13px;
  font-family: 'Yu-Gi-Oh!ITCStoneSerifSmallCaps';
  padding: 6px 20px;
  cursor: pointer;
}

/* The "[username] will go first" banner shown once, before the field
   itself ever mounts — larger and more prominent than the plain status
   text (e.g. "Waiting for both players…") this shares a container with,
   since this is a one-time announcement rather than a passive status
   line. */
.MultiplayerDuelFieldPage-firstPlayerAnnouncement {
  font-size: 28px;
}

/* The "Duel X of 3" line shown under the first-player announcement —
   smaller and secondary to it. */
.MultiplayerDuelFieldPage-duelAnnouncementSubtext {
  font-size: 14px;
  margin-top: 4px;
}

/* Floats above the field, centered, while either Fusion or Evolution
   Summon's material selection is in progress — see pendingFusionSummon /
   pendingEvolutionSummon in MultiplayerDuelFieldPage.tsx. */
.MultiplayerDuelFieldPage-materialSelectionBanner {
  position: absolute;
  top: 8px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 200;
  background: #16171dee;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 6px;
  padding: 8px 14px;
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: 'Yu-Gi-Oh!ITCStoneSerifSmallCaps';
  font-size: 13px;
  color: var(--text);
  white-space: nowrap;
}

.MultiplayerDuelFieldPage-materialSelectionBanner button {
  font-size: 12px;
  font-family: 'Yu-Gi-Oh!ITCStoneSerifSmallCaps';
  padding: 3px 12px;
  cursor: pointer;
}

.MultiplayerDuelFieldPage-materialSelectionBanner button:disabled {
  cursor: default;
  opacity: 0.5;
}
/* The opponent's hand is rendered in a viewport-level layer rather than
   inside the boardStage's clipping context, so OPPONENT_HAND_TOP (which
   sits above boardStage's own top edge) doesn't get hard-clipped by
   .MultiplayerDuelFieldPage's own overflow: hidden — only the deliberate
   partial cutoff further up should apply.
   Since ViewportScaler (src/components/ViewportScaler) wraps the whole
   app in an ancestor with transform: scale(...), this layer's real
   containing block is THAT ancestor, not the browser viewport (a
   transform on an ancestor becomes the containing block for every
   position: fixed descendant, per spec) — so `inset: 0` alone would only
   span the page's own box, the same box .MultiplayerDuelFieldPage already
   clips against, defeating the whole point. top is pulled up well past
   OPPONENT_HAND_TOP (-110, in cardGeometry.ts) plus a full hand card's
   own height instead, to reproduce the same generous headroom the real
   viewport used to provide for free.
   IMPORTANT: this box is also every hand card's own positioning
   container (its nearest position: fixed/absolute ancestor), so pulling
   its top up like this shifts what "top: 0" means for every card inside
   it by the same 300px. CardLayer.tsx's updateOffset adds that 300px
   back in (OPPONENT_HAND_LAYER_TOP_HEADROOM) to compensate — change that
   constant to match if this value ever changes, or cards end up
   rendered off the top of the screen. */
.MultiplayerDuelFieldPage-opponentHandLayer {
  position: fixed;
  top: -300px;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 90;
}
</file>

<file path="src/App.tsx">
import { BrowserRouter, Routes, Route } from 'react-router-dom';
import { AuthProvider } from './auth/AuthContext';
import ProtectedRoute from './auth/ProtectedRoute';
import ViewportScaler from './components/ViewportScaler/ViewportScaler';
import AuthPage from './pages/AuthPage';
import LandingPage from './pages/LandingPage';
import DuelMenuPage from './pages/DuelMenuPage';
import MultiplayerDuelFieldPage from './pages/MultiplayerDuelFieldPage';
import DeckBuilderPage from './pages/DeckBuilderPage';
import AccountPage from './pages/AccountPage';
import ReplaysPage from './pages/ReplaysPage';
import ReplayFieldPage from './pages/ReplayFieldPage';

function App() {
  return (
    <BrowserRouter>
      <AuthProvider>
        {/* Scales every routed page uniformly to fit the actual window —
            see ViewportScaler.tsx for why this is what makes window
            resizing and native browser zoom both behave the DuelingBook
            way ("everything shrinks to fit, nothing moves relative to
            anything else"). Wrapping it here, once, around every Route
            rather than inside each page individually, is what lets it
            react to route changes (a differently-sized page swapping in)
            for free, via the ResizeObserver watching its own content. */}
        <ViewportScaler>
          <Routes>
            <Route path="/login" element={<AuthPage />} />
            <Route
              path="/"
              element={
                <ProtectedRoute>
                  <LandingPage />
                </ProtectedRoute>
              }
            />
            <Route
              path="/duel"
              element={
                <ProtectedRoute>
                  <DuelMenuPage />
                </ProtectedRoute>
              }
            />
            <Route
              path="/duel/multiplayer/:duelId"
              element={
                <ProtectedRoute>
                  <MultiplayerDuelFieldPage />
                </ProtectedRoute>
              }
            />
            <Route
              path="/deck-builder"
              element={
                <ProtectedRoute>
                  <DeckBuilderPage />
                </ProtectedRoute>
              }
            />
            <Route
              path="/account"
              element={
                <ProtectedRoute>
                  <AccountPage />
                </ProtectedRoute>
              }
            />
            <Route
              path="/replays"
              element={
                <ProtectedRoute>
                  <ReplaysPage />
                </ProtectedRoute>
              }
            />
            <Route
              path="/replays/:duelId"
              element={
                <ProtectedRoute>
                  <ReplayFieldPage />
                </ProtectedRoute>
              }
            />
          </Routes>
        </ViewportScaler>
      </AuthProvider>
    </BrowserRouter>
  );
}

export default App;
</file>

